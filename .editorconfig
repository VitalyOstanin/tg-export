# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 110

# TOML is left to the root rule of four spaces: the one TOML file of the
# repository -- pyproject.toml -- is written that way, and no formatter of the
# check set touches TOML to keep the two in step.
[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.html]
indent_size = 2
